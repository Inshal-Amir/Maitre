# Maitre platform API settings. Copy to .env (never commit .env).
MAITRE_PROFILE=mock                     # mock | dev-local-4b | gpu
MAITRE_DATABASE_URL=postgresql+psycopg://maitre_platform:<password>@127.0.0.1:5433/maitre_platform
MAITRE_LITELLM_BASE_URL=http://127.0.0.1:4000
MAITRE_LITELLM_MASTER_KEY=<LiteLLM master key, server secret>
MAITRE_PLAYGROUND_GATEWAY_KEY=<restricted LiteLLM key from: python -m app.cli create-gateway-key>
MAITRE_KEY_HMAC_SECRET=<openssl rand -hex 32>
MAITRE_SESSION_SECRET=<openssl rand -hex 32>
MAITRE_COOKIE_SECURE=false              # true behind HTTPS
MAITRE_CORS_ORIGINS=["http://127.0.0.1:5173"]
MAITRE_PUBLIC_API_BASE=http://127.0.0.1:8200/v1   # https://api.<OWNER_DOMAIN>/v1 in production
