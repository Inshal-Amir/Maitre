# Copy to <repo>/.server-secrets/server.env on the GPU PC (WSL). Never commit the real file.
COMPANY_DOMAIN=menthiq.com                 # console: maitre.<domain>, API: api.<domain> (override with CONSOLE_HOST / API_HOST)
MAITRE_MODEL_DIR=/home/CHANGE-ME/maitre-models   # SSD path OUTSIDE the repository (init steps set it)

# Model engine: llamacpp (default; GGUF MoE, experts spill into system RAM) or vllm (safetensors, many users).
MAITRE_ENGINE=llamacpp

# Default model: Qwen3.6-35B-A3B (MoE, 3B active), Unsloth dynamic 4-bit GGUF, about 22.4 GB.
# On a 16 GB GPU the attention/shared layers stay in VRAM and the remaining experts use system RAM.
MAITRE_MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
MAITRE_MODEL_REVISION=a483e9e6cbd595906af30beda3187c2663a1118c
MAITRE_MODEL_SUBDIR=Qwen3.6-35B-A3B-GGUF-a483e9e
MAITRE_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
MAITRE_MODEL_SHA256=707a55a8a4397ecde44de0c499d3e68c1ad1d240d1da65826b4949d1043f4450
MAITRE_MAX_MODEL_LEN=65536                 # context window; the model supports up to 262144
MAITRE_MAX_NUM_SEQS=1                      # parallel requests served at once
MAITRE_REASONING=on                        # Qwen3.6 thinking mode (model card: coding/agentic sampling below)
MAITRE_TEMPERATURE=0.6
MAITRE_TOP_P=0.95
MAITRE_LLAMACPP_EXTRA_ARGS=
LLAMACPP_IMAGE_TAG=server-cuda-v0.4.1

# vLLM alternative (set MAITRE_ENGINE=vllm and replace the model lines above), e.g.
#   MAITRE_MODEL_REPO=Qwen/Qwen3-4B-Instruct-2507
#   MAITRE_MODEL_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
#   MAITRE_MODEL_SUBDIR=Qwen3-4B-Instruct-2507-cdbee75
#   MAITRE_MODEL_FILE=                     # empty: download the whole safetensors snapshot
#   MAITRE_MAX_MODEL_LEN=4096
MAITRE_TOOL_PARSER=hermes                  # vllm only; verify: docker run --rm vllm/vllm-openai:v0.29.0 --help | grep -A3 tool-call-parser
MAITRE_GPU_MEM_UTIL=0.90                   # vllm only
MAITRE_VLLM_EXTRA_ARGS=
VLLM_IMAGE_TAG=v0.29.0

# Hardware guard (scripts/server/guard.sh). Limits are also capped by the card's own reported limits.
MAITRE_GUARD_COOLDOWN_C=80                 # stop the model until the GPU cools to RESUME
MAITRE_GUARD_RESUME_C=70
MAITRE_GUARD_SHUTDOWN_C=87                 # stop the model and keep it stopped (guard-reset.sh to clear)
MAITRE_GUARD_MAX_COOLDOWN_S=900            # shut down if a cool-down takes longer than this
MAITRE_GUARD_MIN_RAM_MIB=1024              # shut down if available RAM drops below this

# Hardware guard (pauses the model on GPU heat or low RAM; scripts/server/guard.sh). off = not started.
MAITRE_GUARD=off
